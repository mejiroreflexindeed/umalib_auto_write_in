{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.umalib-ingest.invalid/contracts/approved-package.schema.json",
  "title": "ApprovedSubmissionPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inbox", "submission", "package_sha256"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "status",
        "snapshot_sha256",
        "content_sha256",
        "created_at",
        "approved_at"
      ],
      "properties": {
        "item_id": { "type": "integer", "minimum": 1 },
        "status": { "const": "approved" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "content_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "created_at": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 }
      }
    },
    "submission": {
      "$ref": "submission.schema.json"
    },
    "package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
